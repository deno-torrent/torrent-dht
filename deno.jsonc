{
  "name": "@deno-torrent/torrent-dht",
  "version": "2.0.0",
  "exports": {
    ".": "./mod.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "MIGRATION_2.0.md",
      "RELEASING.md",
      "deno.jsonc",
      "mod.ts",
      "src/**/*.ts"
    ]
  },
  "imports": {
    // JSR 官方库 - deno-torrent 套件
    "@deno-torrent/bencode": "jsr:@deno-torrent/bencode@^2.0.0",
    "@deno-torrent/toolkit": "jsr:@deno-torrent/toolkit@^2.0.0",
    // JSR 标准库
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/bytes": "jsr:@std/bytes@^1.0.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    // 项目内部路径别名
    "~/": "./"
  },
  "tasks": {
    "dev": "deno run -A --unstable-net main.ts",
    "fmt": "deno fmt --check",
    "lint": "deno lint",
    "check": "deno check --frozen mod.ts main.ts && deno test --no-run --frozen",
    "test": "deno test --frozen --ignore=test/dht_test.ts --ignore=test/dht_network_test.ts",
    "test:integration": "deno test -A --unstable-net --frozen test/dht_test.ts",
    "test:network": "deno test -A --unstable-net --frozen test/dht_network_test.ts",
    "verify:version": "deno run --allow-read=deno.jsonc scripts/verify_version.ts"
  },
  "test": {
    "include": [
      "./test"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "indentWidth": 2,
    "singleQuote": true,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
